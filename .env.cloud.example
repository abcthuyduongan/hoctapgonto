# Sao thành .env.cloud.local, điền giá trị thật trên máy riêng.
# Không commit tệp .local. Không dùng tiền tố VITE_ cho khóa/mật khẩu.
# Không cần tệp này cho bản chạy cục bộ SQLite.

# HTTPS chính xác của website Netlify, không thêm đường dẫn.
BAO_AN_PUBLIC_ORIGIN=
# Chuỗi ngẫu nhiên riêng >=24 ký tự, dùng tạo quản trị đầu tiên.
BAO_AN_SETUP_TOKEN=

# Connect > Transaction pooler: URI PostgreSQL đầy đủ, thường cổng 6543.
# Mã hóa ký tự đặc biệt trong mật khẩu URI. Không tự đoán hostname pooler.
SUPABASE_DB_URL=
SUPABASE_URL=
# Khóa secret dành cho máy chủ (sb_secret_...). Không dùng publishable/anon.
SUPABASE_SECRET_KEY=
# Hoặc khóa service_role cũ (chỉ điền một trong hai loại khóa).
# SUPABASE_SERVICE_ROLE_KEY=
BAO_AN_MEDIA_BUCKET=bao-an-media

# Tùy chọn: URI Direct hoặc Session pooler riêng cho migration SQL.
# Nếu bỏ trống, cloud:setup dùng SUPABASE_DB_URL; cloud:check luôn kiểm tra URI runtime.
SUPABASE_MIGRATION_DB_URL=
# CA PEM từ Supabase Database > SSL. Viết một dòng chứa \n hoặc chuỗi nhiều dòng có dấu nháy.
SUPABASE_DB_CA=
# Chỉ cần khi chứng chỉ migration khác runtime; mặc định dùng SUPABASE_DB_CA.
SUPABASE_MIGRATION_DB_CA=
